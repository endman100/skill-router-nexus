{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectorspacelab.github.io/AREX-Skill/schemas/category-taxonomy.schema.json",
  "title": "Skill Router Nexus selective category taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "categories"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "categories": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Z0-9][A-Za-z0-9]*(?:-[A-Za-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subcategories"],
        "properties": {
          "subcategories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "description"],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "name": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
